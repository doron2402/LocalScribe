# Copy to .env.bot. The service-account key goes in ./secrets/, never in git.

# The bot's own Google Workspace user. Its name is what people see in the call.
LOCALSCRIBE_BOT_EMAIL=notetaker@example.com
# Comma-separated. Anyone else counts as external and is never shared the note.
LOCALSCRIBE_BOT_DOMAINS=example.com
# The Drive folder notes are filed under. Everyone with access to it can read
# every note in it, including 1:1s, so keep its membership small.
LOCALSCRIBE_BOT_DRIVE_FOLDER_ID=

# Whose calendars to watch: an admin to list everyone, or an explicit list.
LOCALSCRIBE_BOT_ADMIN_EMAIL=admin@example.com
# LOCALSCRIBE_BOT_CALENDAR_USERS=a@example.com,b@example.com

# What to skip. Events tagged in their title or description are always skipped,
# as are private events and events with fewer than two people.
# LOCALSCRIBE_BOT_OPT_OUT_TAG=[no-notes]
# LOCALSCRIBE_BOT_SKIP_EXTERNAL=1
# LOCALSCRIBE_BOT_SKIP_ONE_ON_ONE=1

# Posted in the call's chat when the bot arrives.
# LOCALSCRIBE_BOT_NOTICE=This is an automated notetaker. It is recording this meeting.

# LOCALSCRIBE_BOT_MAX_CONCURRENT=4

# Summarizer: ollama (on the Docker host) keeps the text on this machine; anthropic
# sends the transcript text to the API; extractive needs no model but reads roughly.
LOCALSCRIBE_SUMMARY_BACKEND=ollama
# ANTHROPIC_API_KEY=

# Smaller is faster on CPU: medium.en, small.en, base.en
LOCALSCRIBE_WHISPER_MODEL=large-v3-turbo
