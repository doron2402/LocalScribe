# All optional — every setting below has a working default.

# Where recordings, transcripts and summaries land
# LOCALSCRIBE_DATA_DIR=~/LocalScribe

# Audio devices, matched as a case-insensitive substring of the device name.
# Run `localscribe devices` to see what's available.
# LOCALSCRIBE_MIC_DEVICE=MacBook Pro Microphone
# LOCALSCRIBE_LOOPBACK_DEVICE=BlackHole

# Speech engine: auto | faster-whisper | mlx
# auto picks mlx on Apple Silicon when it is installed (Metal GPU, ~3x faster).
# LOCALSCRIBE_ENGINE=auto

# Whisper. large-v3-turbo is the best speed/accuracy tradeoff on Apple Silicon.
# Smaller and faster: medium.en, small.en, base.en
# LOCALSCRIBE_WHISPER_MODEL=large-v3-turbo
# LOCALSCRIBE_WHISPER_LANG=en          # empty = autodetect
# LOCALSCRIBE_WHISPER_COMPUTE=int8     # int8 | int8_float32 | float32

# Summarizer: ollama (local) | anthropic (cloud) | extractive (no model)
# LOCALSCRIBE_SUMMARY_BACKEND=ollama
# LOCALSCRIBE_OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://127.0.0.1:11434

# Only needed for --backend anthropic. The transcript text is sent to the API;
# the audio never is.
# ANTHROPIC_API_KEY=sk-ant-...
# LOCALSCRIBE_ANTHROPIC_MODEL=claude-sonnet-5
