# All optional — every setting below has a working default.

# Where recordings, transcripts and summaries land
# MEETNOTES_DATA_DIR=~/MeetNotes

# Audio devices, matched as a case-insensitive substring of the device name.
# Run `meetnotes devices` to see what's available.
# MEETNOTES_MIC_DEVICE=MacBook Pro Microphone
# MEETNOTES_LOOPBACK_DEVICE=BlackHole

# Whisper. large-v3-turbo is the best speed/accuracy tradeoff on Apple Silicon.
# Smaller and faster: medium.en, small.en, base.en
# MEETNOTES_WHISPER_MODEL=large-v3-turbo
# MEETNOTES_WHISPER_LANG=en          # empty = autodetect
# MEETNOTES_WHISPER_COMPUTE=int8     # int8 | int8_float32 | float32

# Summarizer: ollama (local) | anthropic (cloud) | extractive (no model)
# MEETNOTES_SUMMARY_BACKEND=ollama
# MEETNOTES_OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://127.0.0.1:11434

# Only needed for --backend anthropic. The transcript text is sent to the API;
# the audio never is.
# ANTHROPIC_API_KEY=sk-ant-...
# MEETNOTES_ANTHROPIC_MODEL=claude-sonnet-5
